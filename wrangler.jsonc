{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hanmazzi",
  "main": "src/worker.js",
  "compatibility_date": "2026-05-21",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hanmazzi-db",
      // Cloudflare 대시보드 → Storage & Databases → D1 에서 hanmazzi-db 를 만든 뒤
      // 그 데이터베이스의 ID 를 아래에 붙여 넣으세요. (README 참고)
      "database_id": "PASTE-YOUR-D1-DATABASE-ID-HERE"
    }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
